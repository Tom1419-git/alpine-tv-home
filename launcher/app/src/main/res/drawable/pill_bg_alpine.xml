<?xml version="1.0" encoding="utf-8"?>
<!-- Pilules de l'accueil alpin : verre sombre au repos (86 %), pour que le texte blanc reste lisible sur un ciel clair
     (contraste d'au moins 4,5:1, SceneZones) ; focus et mode deplacement comme pill_bg. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#DB0E141A" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
